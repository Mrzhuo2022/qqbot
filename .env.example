# 复制为 .env 后按需修改；列表用 JSON 写法，如 [123456, 654321]
# 全部键都有默认值，最小启动只需改 onebot_access_token / llm_api_key / superusers

# ── 连接与权限 ─────────────────────────────────────────
# OneBot 反向 WS 鉴权令牌，NapCat 网络配置里要填同一个
onebot_access_token=please-change-me
# 管理员 QQ 号（/bot 命令、手动推送）
superusers=[]

# ── LLM（任意 OpenAI 兼容接口：DeepSeek/GLM/Kimi/OpenAI…）──
llm_api_key=sk-xxxx
llm_base_url=https://api.deepseek.com
llm_model=deepseek-chat
# 图片理解（需 vision 模型，如 glm-4v-flash），留空关闭
llm_vision_model=
# vision 厂商与主模型不同时单独配（留空跟随上面）
llm_vision_base_url=
llm_vision_api_key=
# 人设 prompt
#llm_system_prompt=你是一个活跃在QQ群里的智能助手……
llm_max_context_rounds=8
# 备用通道：主通道失败自动切换，恢复自动切回（三项都填才启用；图片请求不走备用）
llm_fallback_base_url=
llm_fallback_api_key=
llm_fallback_model=
# 单次 LLM 调用超时（秒），本地大模型/高峰期慢就调大
llm_timeout=90
# 会话/群上下文保留天数（0=永久）
llm_history_ttl_days=14
# 历史压缩：超过上限时旧轮次总结成滚动摘要，只留最近几轮原文
llm_history_compress=true
# 压缩后保留最近几轮原文
llm_compress_keep_rounds=6

# ── 群与插件 ───────────────────────────────────────────
# 只响应这些群（空 [] = 所有群）
group_whitelist=[]
# 各群单独关闭的功能：{"群号": ["插件名", ...]}，如 {"123456": ["proactive", "news"]}
# 可选插件名：chat 聊天 / link_parser 链接 / video_parser 视频 / forward_parser 转发解析
# / chat_analyze 群聊分析 / quote 一言 / news 新闻 / group_digest 晚报 / remind 提醒
# / rank 排行 / weather 天气 / translate 翻译 / image_gen 生图 / proactive 主动回复 / voice 语音（重启生效）
group_plugin_off={}
# 网页链接自动抓正文让 AI 总结：仅限知名内容平台，个人域名/杂站不触发。
# B站视频/转发解析等专门插件不受影响
link_parser_enabled=true
# 网页总结白名单（域名后缀匹配，含子域名；留空 = 不处理任何网页链接）。
# 只收重点平台，想加其他网站往列表里补域名即可
link_parser_whitelist=["zhihu.com","mp.weixin.qq.com","bilibili.com"]
# 总结后随文发出的正文图片张数上限（0 = 不发图）
link_parser_max_images=3
# 这些白名单域名只发 AI 总结：不贴原文、不发配图（公众号长文适合）
link_parser_summary_only=["mp.weixin.qq.com"]
# 知乎 cookie：知乎网页端有浏览器 JS 质询（zse-ck），无登录态一律 403。
# 从已登录浏览器复制 Cookie 请求头整串填入（F12 → Network → 任意 zhihu.com
# 请求 → Request Headers → Cookie）；不填则知乎链接只提示无法抓取
zhihu_cookie=
# 小红书 cookie：网页版需登录态（免 cookie 路线已失效），填法同上；不填只提示
xhs_cookie=
# 抖音 cookie：分享页需登录态，填法同上；不填只提示
douyin_cookie=
# 注入话术启发式检测（关掉可减少误报）
enable_injection_guard=true

# ── 行为调优 ───────────────────────────────────────────
reply_max_chars=3000
reply_chunk_chars=1500
# 每群每分钟 LLM 调用上限
chat_rate_per_min=12
# 每人每分钟 LLM 调用上限（防一个人刷光整群额度）
chat_user_rate_per_min=4
parser_rate_per_min=4
# 以这些词开头的群消息免 @ 直接触发对话（空 [] = 仅 @）
chat_wake_words=[]
# @机器人时注入最近 N 条群聊作上下文（0=关闭）
chat_group_context=0
# 单张图片下载体积上限（MB）
image_max_mb=10
# 抓取响应体积上限（MB），超大文件中途掐断
fetch_max_mb=10
# SSRF 防护额外放行网段
ssrf_allow_nets=[]

# ── B站视频下载 ────────────────────────────────────────
bili_video_download=true
# 静默直发：true 时B站视频不解析摘要、不发「正在下载」提示，直接发视频文件
bili_video_silent=false
bili_video_max_mb=100
bili_video_max_height=480
bili_video_max_min=15
bili_video_timeout=300
bili_dl_per_min=2
# 文件缓存（true=按 BV 号留档复用，false=发完即删）
bili_video_keep=false
bili_video_keep_days=7
bili_video_cache_mb=500
# ffmpeg 目录（留空=用系统 PATH）
ffmpeg_path=
# B站接口 cookie（遇 -352 风控时填登录 cookie）
bili_cookie=

# ── Jev 群聊分析（本地 laya 模型后端 或 OpenRouter decisions 接口）──
jev_api_key=
jev_model=typesafe/jev-1.13
jev_api_url=https://openrouter.ai/api/alpha/decisions
# 本地模型：跑开源的 laya 判断模型（GPU 推理、免 key），模型与运行方式见
# https://huggingface.co/convaiinnovations/laya
# 起一个讲同一份 decisions 合同的本地推理服务后，地址填这里
# 填了就优先走本地；连不上且配了 jev_api_key 时自动回落 OpenRouter
jev_local_url=
# 本地后端注册的模型名，留空=后端默认
jev_local_model=
# 单条分析时 LLM 生成候选回复、Jev 排序（多一次 LLM 调用）
jev_suggest_replies=true
jev_rate_per_min=3

# ── 定时新闻（每天60秒读懂世界）────────────────────────
# 推送时间 HH:MM，留空关闭定时（/news 仍可用）
daily_news_time=08:00
daily_news_groups=[]
daily_news_api=https://60s.viki.moe/v2/60s
daily_news_intro=true

# ── AI 热点（/ainews，aihot.news 热点榜 + 每日 AI 日报）──
# 日报推送时间 HH:MM，留空关闭定时（/ainews 仍可用）；日报源站每天 08:00（北京时间）生成
ainews_time=09:00
ainews_groups=[]
# 推送目标个人 QQ 号（私聊推送），和群号可同时配
ainews_users=[]
ainews_api=https://aihot.news

# ── HN 日报（/hndaily，读本机 hn-daily 项目的 output/api/latest.json）──
# 推送时间 HH:MM，留空关闭定时（/hndaily 仍可用）；要配在 hn-daily 的生成时间
# 之后（生成时间在 hn-daily 那边配），到点还没报就是那边出了问题
hndaily_time=08:30
hndaily_groups=[]
# 推送目标个人 QQ 号（私聊推送），和群号可同时配
hndaily_users=[]
# hn-daily 落盘的 API payload 路径
hndaily_json=/opt/hn-daily/output/api/latest.json

# ── 联网搜索（/search；群聊 @bot 带「联网/搜一下」等词也触发，结果 LLM 总结）──
# 搜索源 key 填哪个用哪个，全空=功能关闭（消息含触发词也不响应，照常聊天）：
#   Tavily     https://tavily.com       免费 1000 次/月，海外内容质量好
#   博查 Bocha  https://open.bochaai.com 国内内容好，按次计费
#   Firecrawl  https://firecrawl.dev    搜索+抓取一体，免费额度按 credits
#   Jina       https://jina.ai          搜索+正文提炼一体，免费约 1M tokens
search_tavily_api_key=
search_bocha_api_key=
search_firecrawl_api_key=
search_jina_api_key=
# 多个源都填了时的顺序，主源失败自动兜底下一个
search_provider_order=["tavily","bocha","firecrawl","jina"]
# 聊天触发词（子串包含，可自己增删；群聊要 @/引用 bot 才生效，私聊直接说；
# 裸「搜索」刻意不在表里，防「搜索引擎」误触）
search_wake_words=["联网","搜一下","搜索一下","帮我搜"]
# 每次取几条结果；每群/每人每分钟最多搜几次
search_max_results=5
search_rate_per_min=4

# ── 群聊晚报 ───────────────────────────────────────────
# 出报时间 HH:MM，留空关闭定时（/digest 仍可用）
digest_time=22:30
digest_groups=[]
digest_max_messages=100
# 当天消息不足该条数不出报（安静群不打扰）
digest_min_messages=10
digest_rate_per_min=2

# ── 翻译（/translate，LLM 直译）────────────────────────
translate_rate_per_min=6

# ── 图像生成（/生图，通用 OpenAI 图像接口 POST /v1/images/generations）──
# api_key 和 model 都填了才启用 /生图；base_url 留空走 OpenAI 官方
# OpenAI:      image_gen_base_url=https://api.openai.com/v1              image_gen_model=dall-e-3
# 智谱CogView: image_gen_base_url=https://open.bigmodel.cn/api/paas/v4   image_gen_model=cogview-3-flash
# SiliconFlow: image_gen_base_url=https://api.siliconflow.cn/v1          image_gen_model=Kwai-Kolors/Kolors
image_gen_api_key=
image_gen_base_url=
image_gen_model=
image_gen_size=1024x1024
# 出图超时（秒）；本地模型/排队慢的服务调大
image_gen_timeout=180
# 每群每分钟最多几次生图
image_gen_rate_per_min=3

# ── TTS 语音回复（/bot on|off 语音 按群开关；通用 OpenAI audio/speech 接口）──
# model 填了才启用；api_url 留空走 OpenAI 官方，云端本地服务通吃
# OpenAI:     tts_api_url=https://api.openai.com/v1   tts_model=tts-1
# SiliconFlow tts_api_url=https://api.siliconflow.cn/v1（模型名看服务模型列表）
# 本地服务:   tts_api_url=http://127.0.0.1:PORT/v1    tts_model=填服务要求的模型名
tts_api_url=
tts_api_key=
tts_model=
# OpenAI 标准音色名（alloy/echo/fable/onyx/nova/shimmer…具体音色集看所接服务）
tts_voice=alloy
tts_speed=1.0
# 单条语音文本上限（QQ 语音有时长限制）；超长产出语音念开头、完整文字照发
tts_max_chars=150
# 合成超时（秒）；本地推理慢的服务调大
tts_timeout=30

# ── 主动回复（不需要 @，bot 像群友一样看聊天接话）──────
# 总开关（单个群在 group_plugin_off 里关掉 proactive）
proactive_enabled=true
# 每条群消息触发评估的概率（0~1，0=关闭；评估会调一次 LLM）
proactive_chance=0.06
# 同一个群两次主动回复的最小间隔（秒）
proactive_cooldown=120
# 每群每小时主动回复硬上限（概率/冷却配到极限也不会刷屏）
proactive_max_per_hour=8
# 评估时带上最近多少条群聊
proactive_context=12
# 静音时段，该时段绝不主动回复（留空=不静音；start>end 按跨午夜算）
proactive_quiet_start=01:00
proactive_quiet_end=08:00

# ── 长期记忆 ───────────────────────────────────────────
memory_enabled=true
memory_max_facts=20
# 每次对话给 LLM 注入的事实条数（不超过 memory_max_facts）
memory_prompt_facts=8
memory_extract_cooldown=120
